APP_NAME=Iris API
APP_ENV=development
APP_VERSION=0.1.0

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

OTP_EXPIRE_MINUTES=5
DEV_OTP_CODE=123456

# Em desenvolvimento o código OTP também volta na resposta.
# Em produção, deixe false e integre um provedor real de SMS/WhatsApp.
RETURN_DEV_OTP=true

SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_MAX_LIFETIME_MINUTES=480